# Copy to .env (git-ignored) and fill in, then run `npm run build` and reload the extension.
# The account agent signs in, or creates the account, on career sites that ask for one (Workday, iCIMS, Taleo...),
# with this email and password. It is used on https pages only and never sent to the AI or written to the log.
ACCOUNT_EMAIL=you@example.com
ACCOUNT_PASSWORD=
