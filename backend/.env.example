GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional free fallback provider. When set, any request that
# Gemini fails or rate-limits (the free tier's 250K input-
# tokens-per-minute cap is the usual one) is automatically
# retried on Groq. Groq has its own separate free quota, so
# this roughly doubles the daily headroom. Get a key (no card)
# at https://console.groq.com/keys . Leave unset to disable.
GROQ_API_KEY=
# Groq fallback models (per endpoint). Free tier ~8K tokens/min on
# gpt-oss: fine for /answer; for the rapid-fire browser agent the
# 429s just get waited out by the retry loop (~10-40s/step under
# load) — a backstop, not a fast path. compound-* models 413 on an
# agent-sized prompt, so keep both on gpt-oss unless you upgrade.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_AGENT_MODEL=openai/gpt-oss-120b

# Optional but strongly recommended once this backend is deployed
# anywhere reachable outside your own machine (e.g. Render/Railway) —
# requires every request to carry a matching X-App-Key header, so a
# stranger who finds the URL can't spend your Gemini quota. Leave
# unset for local-only development.
APP_ACCESS_KEY=
