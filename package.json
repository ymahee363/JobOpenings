{
  "name": "naukri-fast-apply",
  "version": "0.1.0",
  "private": true,
  "description": "Personal Chrome extension: Naukri openings sorted by date, split into Easy Apply and Company Site tabs.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "fixer:prep": "node scripts/auto-fixer/prep.mjs"
  },
  "dependencies": {
    "dexie": "^4.0.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.0.0",
    "happy-dom": "^21.0.4",
    "typescript": "^5.6.3",
    "vitest": "^5.0.5"
  }
}
